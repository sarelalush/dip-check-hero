{
  "expo": {
    "name": "AquaSense",
    "slug": "comstickcheckapp",
    "version": "0.1.0",
    "orientation": "portrait",
    "scheme": "aquasense",
    "userInterfaceStyle": "light",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.sarelalush.aquasense",
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false,
        "NSPhotoLibraryUsageDescription": "אפשר ל-AquaSense לבחור תמונת סטיק מהגלריה.",
        "NSCameraUsageDescription": "אפשר ל-AquaSense לצלם סטיק בדיקה."
      }
    },
    "android": {
      "package": "com.stickcheck.app",
      "permissions": [
        "android.permission.RECORD_AUDIO"
      ]
    },
    "extra": {
      "eas": {
        "projectId": "c53fc211-eb21-40ee-8bdf-afbfcabbab76"
      }
    },
    "plugins": [
      "./plugins/withAndroidRtl",
      "expo-font",
      [
        "expo-image-picker",
        {
          "photosPermission": "אפשר ל-AquaSense לבחור תמונת סטיק מהגלריה.",
          "cameraPermission": "אפשר ל-AquaSense לצלם סטיק בדיקה."
        }
      ],
      "expo-web-browser"
    ],
    "owner": "sarelalush1"
  }
}
