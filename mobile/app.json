{
  "expo": {
    "name": "AquaSense",
    "slug": "dip-check-hero",
    "version": "0.1.0",
    "orientation": "portrait",
    "userInterfaceStyle": "light",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.sarelalush.aquasense",
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false,
        "NSPhotoLibraryUsageDescription": "אפשר ל-AquaSense לבחור תמונת סטיק מהגלריה.",
        "NSCameraUsageDescription": "אפשר ל-AquaSense לצלם סטיק בדיקה."
      }
    },
    "android": {
      "package": "com.sarelalush.aquasense"
    },
    "extra": {
      "eas": {
        "projectId": "20113056-3bf8-4a05-ae7a-13e18f6b8dc5"
      }
    },
    "plugins": [
      "expo-font",
      [
        "expo-image-picker",
        {
          "photosPermission": "אפשר ל-AquaSense לבחור תמונת סטיק מהגלריה.",
          "cameraPermission": "אפשר ל-AquaSense לצלם סטיק בדיקה."
        }
      ]
    ]
  }
}
